import {
    createContext,
    useCallback,
    useContext,
    useEffect,
    useId,
    useLayoutEffect,
    useMemo,
    useRef,
} from "react";

const CanvasContext = createContext(null);

/**
 * <Canvas> – kontener 2D. Jego dzieci (Line, Rect, ...) nie renderują DOM,
 * tylko rejestrują funkcje rysujące w kontekście <canvas>.
 */
export function Canvas({
    width = 300,
    height = 150,
    background,
    children,
    ...canvasProps
}) {
    const canvasRef = useRef(null);
    const items = useRef(new Map()); // id -> funkcja rysująca (kolejność = z-index)
    const frame = useRef(0);
    const bg = useRef(background);
    bg.current = background;

    const draw = useCallback(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const dpr = window.devicePixelRatio || 1;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (bg.current) {
            ctx.fillStyle = bg.current;
            ctx.fillRect(0, 0, canvas.width / dpr, canvas.height / dpr);
        }
        for (const fn of items.current.values()) {
            ctx.save();
            fn(ctx);
            ctx.restore();
        }
    }, []);

    // Wiele zmian w jednej klatce => jedno przerysowanie
    const invalidate = useCallback(() => {
        if (frame.current) return;
        frame.current = requestAnimationFrame(() => {
            frame.current = 0;
            draw();
        });
    }, [draw]);

    const api = useMemo(
        () => ({
            register(id, fn) {
                items.current.set(id, fn); // set na istniejącym kluczu zachowuje pozycję
                invalidate();
            },
            unregister(id) {
                items.current.delete(id);
                invalidate();
            },
        }),
        [invalidate]
    );

    // Rozmiar + HiDPI (zmiana width/height czyści canvas, więc przerysowujemy)
    useLayoutEffect(() => {
        const canvas = canvasRef.current;
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        invalidate();
    }, [width, height, invalidate]);

    useEffect(() => {
        invalidate();
    }, [background, invalidate]);

    useEffect(() => () => cancelAnimationFrame(frame.current), []);

    return (
        <CanvasContext.Provider value={api}>
            <canvas ref={canvasRef} {...canvasProps} />
            {children}
        </CanvasContext.Provider>
    );
}

/** Hak do tworzenia własnych kształtów: useDraw((ctx) => { ... }) */
export function useDraw(draw) {
    const api = useContext(CanvasContext);
    if (!api) throw new Error("Element rysujący musi być wewnątrz <Canvas>.");
    const id = useId();

    useEffect(() => {
        api.register(id, draw);
    }, [api, id, draw]);

    useEffect(() => () => api.unregister(id), [api, id]);
}

/** <Line x={12} y={45} vector={{ x: 10, y: 12 }} /> */
export function Line({
    x = 0,
    y = 0,
    vector,
    color = "#000",
    width = 1,
    cap = "round",
}) {
    const vx = vector.x;
    const vy = vector.y;

    const draw = useCallback(
        (ctx) => {
            ctx.beginPath();
            ctx.moveTo(x, y);
            ctx.lineTo(x + vx, y + vy);
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.lineCap = cap;
            ctx.stroke();
        },
        [x, y, vx, vy, color, width, cap]
    );

    useDraw(draw);
    return null;
}

/** <Rect x={10} y={10} w={50} h={30} fill="tomato" /> */
export function Rect({ x = 0, y = 0, w, h, fill, stroke, lineWidth = 1 }) {
    const draw = useCallback(
        (ctx) => {
            if (fill) {
                ctx.fillStyle = fill;
                ctx.fillRect(x, y, w, h);
            }
            if (stroke) {
                ctx.strokeStyle = stroke;
                ctx.lineWidth = lineWidth;
                ctx.strokeRect(x, y, w, h);
            }
        },
        [x, y, w, h, fill, stroke, lineWidth]
    );

    useDraw(draw);
    return null;
}

/* ---------- Przykład użycia ---------- */
export default function Demo() {
    return (
        <Canvas width={200} height={120} background="#f5f5f5">
            <Rect x={20} y={20} w={80} h={50} fill="#cde" />
            <Line x={12} y={45} vector={{ x: 100, y: 12 }} color="crimson" width={3} />
        </Canvas>
    );
}

